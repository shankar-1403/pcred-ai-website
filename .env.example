# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app (SDK setup and configuration).
# .env.local is git-ignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pcred-ai-website.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=pcred-ai-website
VITE_FIREBASE_APP_ID=

# Local testing against the Firebase emulators (never touches the real project)
# VITE_FIREBASE_EMULATORS=true
