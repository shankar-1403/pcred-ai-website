{
  "rules": {
    "suits": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$slug": {
        ".validate": "$slug.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "summary": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "icon": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "order": {
          ".validate": "newData.isNumber()"
        },
        "banner": {
          ".validate": "newData.hasChildren(['text', 'enabled'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
          },
          "enabled": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "products": {
          "$productId": {
            ".validate": "newData.hasChildren(['name', 'price'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "description": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "order": {
              ".validate": "newData.isNumber()"
            },
            "documents": {
              "$index": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
              }
            },
            "points": {
              "$index": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "discounts": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$tierId": {
        ".validate": "newData.hasChildren(['minAmount', 'percent'])",
        "minAmount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "percent": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "enquiries": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$enquiryId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists() || (!data.exists() && newData.exists() && auth != null && auth.token.phone_number != null && newData.child('phone').val() === auth.token.phone_number && newData.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'email', 'phone', 'uid', 'items', 'total', 'status', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[^ @]+@[^ @]+\\.[^ @]+$/)"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^\\+91[6-9][0-9]{9}$/)"
        },
        "uid": {
          ".validate": "newData.isString()"
        },
        "items": {
          "$index": {
            ".validate": "newData.hasChildren(['name', 'price'])",
            "id": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "suitName": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "subtotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "discountPercent": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "discount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "(newData.val() === 'new' || newData.val() === 'contacted' || newData.val() === 'closed') && (newData.val() === 'new' || auth != null && root.child('admins').child(auth.uid).exists())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "schemes": {
      ".read": true,
      ".write": false
    },
    "leads": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "udyam_number",
        "created_at"
      ]
    },
    "bundlePreviews": {
      ".read": true,
      "$slug": {
        "$productId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 400000"
        }
      }
    }
  }
}
