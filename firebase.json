{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/udyam/verify",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/udyam/checkout",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/udyam/unlock",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/udyam/otp/send",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/udyam/otp/verify",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/udyam/certificate",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/udyam/lead",
        "function": {
          "functionId": "udyamVerify",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/ocr/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.test.js",
        "*.local",
        "firebase-debug.log",
        "udyam/test/**",
        "udyam/vitest.config.js"
      ]
    }
  ]
}
